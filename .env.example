# LensTrace Studio — environment configuration example
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# In the desktop app you can configure bots from the Bots panel instead of
# editing this file; saved tokens are stored securely and are never shown again.
# Booleans accept: true/false, 1/0, yes/no, on/off (anything else = the default).

# ---- Logging ----
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ---- Upload / session limits ----
MAX_UPLOAD_MB=25
SESSION_TIMEOUT_MINUTES=30

# ---- Geocoding (address search) ----
# Address search is optional; manual coordinates always work without it.
# Nominatim usage policy requires a descriptive User-Agent identifying your app.
GEOCODING_ENABLED=true
GEOCODING_PROVIDER=nominatim
GEOCODING_USER_AGENT=LensTraceStudio/0.1
GEOCODING_TIMEOUT_SECONDS=10
GEOCODING_MAX_RESULTS=5
GEOCODING_CACHE_MINUTES=10

# ---- Telegram bot ----
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_AUTO_START=false

# ---- Discord bot ----
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_BOT_AUTO_START=false

# ---- Delivery providers (Send to iPhone) ----
ICLOUD_PHOTOS_ENABLED=true
# Optional explicit iCloud Photos folder (auto-detected if left blank):
ICLOUD_PHOTOS_PATH=
PAIRDROP_ENABLED=true
PAIRDROP_URL=https://pairdrop.net/
# Optional path to a PairDrop CLI executable (browser mode is the default):
PAIRDROP_CLI_PATH=
APPLE_DEVICES_ENABLED=true
# Optional folder used for Apple Devices assisted sync (defaults to
# %USERPROFILE%\Pictures\LensTrace Sync):
LENSTRACE_SYNC_PATH=

# ---- Bot process lifecycle ----
LENSTRACE_STOP_BOTS_ON_EXIT=true
LENSTRACE_RESTART_AFTER_CRASH=false
LENSTRACE_MAX_RESTARTS=3

# ---- Diagnostics ----
LENSTRACE_DEBUG=false

# ---- Backend (normally set by the launcher; override only for advanced use) ----
# LENSTRACE_HOST=127.0.0.1
# LENSTRACE_PORT=0            # 0 = choose an available ephemeral port
# LENSTRACE_SESSION_TOKEN=    # auto-generated by run_desktop.py
